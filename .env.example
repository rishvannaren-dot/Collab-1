# Copy to .env and fill in. Never commit .env.
# SECRET_KEY: leave empty while developing (a random key is saved in instance/secret_key).
# On a real server, set it to a long random string.
SECRET_KEY=
YOUTUBE_API_KEY=
# FLASK_DEBUG=1 turns on auto-reload and the debugger. Only on your own computer.
FLASK_DEBUG=1
# On a real server with HTTPS:
# FOCUSFEED_HTTPS=1
# TRUST_PROXY=1   (only behind a proxy such as nginx that sets X-Forwarded-For/Proto)
